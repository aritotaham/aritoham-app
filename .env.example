# Everything below is optional: the defaults already point at the BSC Testnet deployment.
NEXT_PUBLIC_CHAIN_ID=97
# NEXT_PUBLIC_RPC_URL=https://your-private-bsc-testnet-rpc   # tried first, public RPCs are the fallback
NEXT_PUBLIC_PROTOCOL_ADDRESS=0x9d261167aF37Da41e543e5a1352E0bCE6dAC3534
NEXT_PUBLIC_DATASTORE_ADDRESS=0xD56fabC51df40789889cBa979E6d698E085A9Fec
NEXT_PUBLIC_READER_ADDRESS=0xAEbd131f2A6688BCCD98a68b8e3E1a24DfbCc838
NEXT_PUBLIC_READER_TEAMDAO_ADDRESS=0xd4014A0837fd3BC5D4E40cae2c46Ca9f74F6Aa95
# Block the contracts were deployed at: makes the Txn-hash lookup much faster.
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_LOG_CHUNK=5000
NEXT_PUBLIC_USER_PREFIX=ARI
NEXT_PUBLIC_TX_LOOKUP=1
# Set to 1 to run on demo data instead of the chain.
# NEXT_PUBLIC_DEMO_DATA=1
